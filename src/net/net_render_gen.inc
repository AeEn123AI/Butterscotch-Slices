    if (r->error) { return; }
    if (renderer->vtable->textureSetStage != nullptr) renderer->vtable->textureSetStage(renderer, slot, texID);
}

static void rrDec_setMatrix(NetRenderDecoder* d, NetReader* r) {
    Renderer* renderer = d->renderer;
    int32_t matrixType = NetReader_i32(r);
    Matrix4f matrix; for (int i = 0; i < 16; i++) matrix.m[i] = NetReader_f32(r);
    if (r->error) { return; }
    if (renderer->vtable->setMatrix != nullptr && matrixType >= 0 && matrixType < MATRICES_MAX) renderer->vtable->setMatrix(renderer, matrixType, matrix);
}

