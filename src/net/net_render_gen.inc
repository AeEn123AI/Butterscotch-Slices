    int32_t destX = NetReader_i32(r);
    int32_t destY = NetReader_i32(r);
    int32_t srcSurfaceID = rdMapSurface(d, NetReader_i32(r));
    int32_t srcX = NetReader_i32(r);
    int32_t srcY = NetReader_i32(r);
    int32_t srcW = NetReader_i32(r);
