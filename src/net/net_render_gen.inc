    if (r->error) { return; }
    if (renderer->vtable->surfaceCopy != nullptr) renderer->vtable->surfaceCopy(renderer, destSurfaceID, destX, destY, srcSurfaceID, srcX, srcY, srcW, srcH, part);
}

